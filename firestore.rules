rules_version = '2';

// Secure Shift reads and writes Firestore only from the server (google-cloud-firestore on
// Cloud Run, IAM-authenticated), which bypasses these rules. Browsers and mobile clients get no direct access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
