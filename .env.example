GEMINI_API_KEY=your-gemini-api-key
DEFAULT_MODEL=gemini-3.8-flash
# Google Cloud project that holds your Firestore database
FIRESTORE_PROJECT_ID=your-gcp-project-id
# Only change if your database is not named "(default)"
# FIRESTORE_DATABASE=(default)
# STORAGE_BACKEND=firestore      # or "local" for an offline SQLite store
# LOG_LEVEL=INFO
# DEMO_MODE=true
